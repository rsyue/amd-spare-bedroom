# ==============================================================================
# AMD Spare Bedroom - Environment Configuration Template
# Copy this file to `.env` in the repository root and customize as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# AMD ROCm / HIP Hardware Configuration (Targeting gfx_1151 / Strix Halo)
# ------------------------------------------------------------------------------
# Override GFX target architecture for RDNA 3.5 / gfx1151 (Radeon 8060S)
HSA_OVERRIDE_GFX_VERSION=11.5.1

# System installation path for ROCm runtime libraries
ROCM_PATH=/opt/rocm

# Visible HIP / ROCm device ordinal (usually 0 for unified APU)
HIP_VISIBLE_DEVICES=0

# PyTorch allocator settings: enable expandable memory segments to avoid VRAM fragmentation
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# ------------------------------------------------------------------------------
# Hugging Face Model & Dataset Caching
# ------------------------------------------------------------------------------
# Local cache directory for HuggingFace models, tokenizers, and datasets
HF_HOME=~/.cache/huggingface

# Hugging Face User Access Token (optional; required for gated models like meta-llama/Llama-3.2-1B)
HF_TOKEN=

# Offline switches: set to 1 to force offline execution with cached models/datasets
HF_DATASETS_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ------------------------------------------------------------------------------
# Virtual Grid & Distributed Training Defaults
# ------------------------------------------------------------------------------
# Default physical memory pool budget in gigabytes
AMD_SPARE_BEDROOM_TOTAL_VRAM_GB=96.0

# Execution backend: 'auto' (detects ROCm GPU or falls back to CPU), 'cuda', or 'cpu'
AMD_SPARE_BEDROOM_DEVICE=auto

# Global deterministic random seed for data partitioning, sampling, and initialization
AMD_SPARE_BEDROOM_SEED=42
